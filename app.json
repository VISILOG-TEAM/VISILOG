{
  "expo": {
    "name": "VisiLog",
    "slug": "visilog",
    "scheme": "visilog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E4E55"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.visilog.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VisiLog uses your location to confirm you're at the office before you clock in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VisiLog needs access to your photos to let you upload a company logo or meeting room photo."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VisiLog uses Face ID to confirm it's you before clocking in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#0E4E55"
        }
      ]
    ]
  }
}