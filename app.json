{
  "expo": {
    "name": "VisiLog",
    "slug": "visilog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E4E55"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.visilog.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0E4E55"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VisiLog uses your location to confirm you're at the office before you clock in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VisiLog needs access to your photos to let you upload a company logo or meeting room photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8c7c2123-efd1-40f7-bead-e2c1265844a0"
      }
    }
  }
}
